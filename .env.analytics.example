# Copy this file to .env.analytics.local. Do not commit the local file.
# Keep the downloaded Google service-account key in /secrets, outside version control.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/steady-service-508003-p3-4a71fc17b73e.json
GOOGLE_CLOUD_PROJECT_ID=steady-service-508003-p3
GSC_SITE_URL=sc-domain:dawnwalker.cc
GOOGLE_ANALYTICS_PROPERTY_ID=551486768

# Adsterra Publisher statistics use the X-API-Key header. The default endpoint
# is used unless you deliberately need to override it.
ADSTERRA_API_TOKEN=
ADSTERRA_PUBLISHER_REPORT_URL=https://api3.adsterratools.com/publisher/stats.json
ADSTERRA_API_TOKEN_HEADER=X-API-Key
ADSTERRA_API_TOKEN_PREFIX=

# Optional defaults for scheduled reports.
ANALYTICS_DAYS=28
ANALYTICS_CACHE_PATH=./data/private/analytics-latest.json
